{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gitty",
  "version": "1.1.4",
  "identifier": "com.gitty.radar",
  "build": {
    "frontendDist": "../public",
    "features": ["tray"]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../server.mjs": "server.mjs",
      "../public": "public"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
